<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>PenScroll</AssemblyName>
    <RootNamespace>PenScroll</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>0.2.0</Version>
    <Authors>Matsuda Tetsuya</Authors>
    <Description>Scroll by moving the pen while a pen button is held.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time only: a second copy of this assembly breaks type identity at load. -->
    <PackageReference Include="OpenTabletDriver.Plugin" Version="0.6.7">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
